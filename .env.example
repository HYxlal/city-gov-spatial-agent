# 复制为 .env 后填入真实值；.env 不入库
# cp .env.example .env

# 主 LLM（云端）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地降级模型（断网时使用）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 数据库（只读账号用于智能体查询，读写账号仅用于建库与数据生成）
DATABASE_URL=postgresql://app_ro:password@127.0.0.1:5432/city_gov
DATABASE_URL_RW=postgresql://postgres:password@127.0.0.1:5432/city_gov

# 嵌入模型
EMBEDDING_MODEL=BAAI/bge-m3

# 高德地图（https://lbs.amap.com 申请，需分别申请「Web服务」与「Web端(JS API)」）
AMAP_WEB_KEY=your-amap-web-service-key
AMAP_JS_KEY=your-amap-js-api-key
AMAP_SECURITY_CODE=your-amap-security-js-code

# 地图 provider：amap | mock（mock 无需任何 Key，可离线跑通全链路）
MAP_PROVIDER=mock

# 运行时
LOG_LEVEL=INFO
SRID_DISPLAY=4326        # GCJ-02 经纬度，仅用于展示
SRID_COMPUTE=3857        # 投影坐标，用于面积与距离计算
